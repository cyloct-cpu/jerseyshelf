HOST=127.0.0.1
PORT=3001
DATABASE_PATH=storage/store.sqlite
# 初次初始化可提供 ADMIN_EMAIL 和 ADMIN_PASSWORD；不设置则生成本地管理员凭据文件。
ADMIN_EMAIL=admin@local.test
# ADMIN_PASSWORD=请设置至少12位密码
# 上线使用 HTTPS 时设为 true；本地 HTTP 设为 false。
COOKIE_SECURE=false
# 仅在本机 Nginx 覆盖 X-Real-IP、应用仅监听回环地址时启用。
TRUST_LOCAL_PROXY=false

# 可在后台站点设置配置。没有实时API密钥时保持 reference。
FX_MODE=reference
# FX_API_KEY=实时汇率服务的密钥（currencylayer）

# 免费自动翻译：默认开启，无需密钥；false 关闭后台自动网络请求
TRANSLATION_AUTO_UPDATE=true

# 以图搜款：独立 Python 视觉进程，默认未开放。完整索引及验收后在后台开启。
# IMAGE_SEARCH_PYTHON=/opt/jerseyshelf/image-search/bin/python
IMAGE_SEARCH_STATE=storage/image-search
IMAGE_SEARCH_AUTO_UPDATE=false
# Linux 生产环境使用独立 systemd 服务和私有 Unix socket；本地预览留空。
# IMAGE_SEARCH_SOCKET=/www/wwwroot/jerseyshelf/storage/image-search/search.sock
